# API Keys — at least one transcription key required
ASSEMBLYAI_API_KEY=your_assemblyai_key_here
OPENAI_API_KEY=your_openai_key_here

# Anthropic (required for speaker attribution + summary)
ANTHROPIC_API_KEY=your_anthropic_key_here

# Output directory for transcript/summary markdown (default: data/podcast_transcripts)
OUTPUT_DIR=data/podcast_transcripts
